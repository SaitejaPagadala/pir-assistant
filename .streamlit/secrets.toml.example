# On Streamlit Community Cloud: paste this (with real values) into App settings -> Secrets.
# Locally: copy to .streamlit/secrets.toml (gitignored).
ANTHROPIC_API_KEY = "your-key-here"
APP_PASSWORD = "choose-a-passphrase"   # leave out to disable the password gate
MAX_QUESTIONS_PER_SESSION = 30
MAX_QUESTIONS_PER_DAY = 200
